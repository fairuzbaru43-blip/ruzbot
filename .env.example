BOT_PREFIX=!

# ID lokal untuk sesi perangkat tertaut; ubah hanya jika menjalankan beberapa bot.
WWEBJS_CLIENT_ID=ruzbot
WWEBJS_SESSION_PATH=.wwebjs_auth

# Opsional. Jika kosong, Windows akan mencari Google Chrome di lokasi umum;
# platform lain memakai Chromium yang dikelola Puppeteer.
# Contoh Windows: CHROME_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
CHROME_EXECUTABLE_PATH=

# Opsional; belum digunakan untuk perintah grup aktif.
BOT_OWNER_WA_ID=
BOT_ADMIN_WA_IDS=
